{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Studio: Build",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/.vscode/studio.py", "build", "auto"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "focus": true },
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": ["relative", "${workspaceFolder}/GNU ARM v12.2.1 - Debug"]
      }
    },
    {
      "label": "Studio: Clean (Debug)",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/.vscode/studio.py", "clean", "Debug"],
      "problemMatcher": []
    },
    {
      "label": "Studio: Novo arquivo .c/.h",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/.vscode/studio.py", "new", "${input:nomeArquivo}", "${input:tipoArquivo}"],
      "problemMatcher": []
    },
    {
      "label": "Studio: Sincronizar (makefiles + clangd)",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/.vscode/studio.py", "sync"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "nomeArquivo",
      "type": "promptString",
      "description": "Nome do modulo, sem extensao (ex.: uart_medidor)"
    },
    {
      "id": "tipoArquivo",
      "type": "pickString",
      "description": "O que criar",
      "options": ["ambos", "c", "h"],
      "default": "ambos"
    }
  ]
}
